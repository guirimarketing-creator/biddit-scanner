<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.biddit.scanner</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/maxpelgrims/biddit-scanner/venv/bin/python</string>
        <string>/Users/maxpelgrims/biddit-scanner/main.py</string>
        <string>--no-open</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/maxpelgrims/biddit-scanner</string>

    <!-- Every Sunday at 08:00 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/maxpelgrims/biddit-scanner/logs/scanner.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/maxpelgrims/biddit-scanner/logs/scanner.error.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
